[user]
	name = Luke McDonald
	email = luke+git@lmcd.au
	signingKey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICH/BKTKFciZ6f3a6bIroyJcwa65GzoIUtEOJimfDDT8 lmcd-personal
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = !/usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/env gh auth git-credential
[merge]
	tool = nvimdiff
[gpg]
	format = ssh
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[submodule]
	recurse = true
